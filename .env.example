# Secret key do Formatar Hub. Usada apenas pelo servidor (Cloudflare Pages Function
# em produção, proxy do Vite em desenvolvimento). NUNCA use o prefixo VITE_ aqui:
# variáveis VITE_ são compiladas dentro do JavaScript publicado e ficam visíveis
# para qualquer visitante do site.
HUB_API_SECRET_KEY=

# Supabase (opcional, para persistir o estado do dashboard por usuário)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
